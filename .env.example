# FreightRate AI local/deployment environment example.
# Do not commit real secrets. Replace these values per environment.

# JWT
JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters
JWT_ISSUER=FreightRateAI.Auth
JWT_AUDIENCE=FreightRateAI.Services
JWT_EXPIRY_MINUTES=60

# Auth Service
AUTH_CONNECTION_STRING=Host=postgres;Port=5432;Database=freightrate_auth;Username=postgres;Password=postgres

# Quote Service
QUOTE_CONNECTION_STRING=Host=postgres;Port=5432;Database=freightrate_quote;Username=postgres;Password=postgres
REDIS_CONNECTION_STRING=redis:6379
AI_SERVICE_BASE_URL=http://ai-recommendation-service:8000
AI_SERVICE_TIMEOUT_SECONDS=3

# AI Recommendation Service
AI_PROVIDER=none
AI_MODEL=
AI_TIMEOUT_SECONDS=5
OPENAI_API_KEY=
