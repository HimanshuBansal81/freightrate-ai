# FreightRate AI - Local Environment Template
# Copy this file to .env before running locally:
# cp .env.example .env
#
# This file contains placeholder values only.
# Do NOT commit .env.
# For cloud deployment, use ECS task environment variables and AWS Secrets Manager.
# The optional GCP Cloud Run path uses Cloud Run environment variables and Google Secret Manager.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL - local Docker only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freightrate
AUTH_DB_NAME=freightrate_auth
QUOTE_DB_NAME=freightrate_quote

# JWT - local development only
JWT_SECRET=CHANGE_ME_DEV_ONLY_MINIMUM_32_CHARACTERS
JWT_ISSUER=FreightRateAI.Auth
JWT_AUDIENCE=FreightRateAI.Services
JWT_EXPIRY_MINUTES=60

# Redis - local Docker service
REDIS_CONNECTION_STRING=redis:6379

# AI Recommendation Service
AI_SERVICE_BASE_URL=http://ai-recommendation-service:8000
AI_SERVICE_TIMEOUT_SECONDS=3

# AI Provider - optional
# Keep AI_PROVIDER=none for local fallback-only mode.
# Add real keys only in your local .env or cloud secret manager.
AI_PROVIDER=none
AI_MODEL=
AI_TIMEOUT_SECONDS=5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
