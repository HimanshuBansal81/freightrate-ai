# FreightRate AI local environment example.
# Copy to .env for local development. Never commit real secrets.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freightrate_auth

# Auth DB
AUTH_DB_CONNECTION=Host=postgres;Port=5432;Database=freightrate_auth;Username=postgres;Password=postgres

# Quote DB
QUOTE_DB_CONNECTION=Host=postgres;Port=5432;Database=freightrate_quote;Username=postgres;Password=postgres

# JWT
JWT_SECRET=replace-with-a-long-development-secret-key-at-least-32-characters
JWT_ISSUER=FreightRateAI.Auth
JWT_AUDIENCE=FreightRateAI.Services
JWT_EXPIRY_MINUTES=60

# Redis
REDIS_CONNECTION_STRING=redis:6379

# AI Service
AI_SERVICE_BASE_URL=http://ai-recommendation-service:8000
AI_SERVICE_TIMEOUT_SECONDS=3

# AI Provider - optional for local dev
AI_PROVIDER=none
AI_MODEL=
AI_TIMEOUT_SECONDS=5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
